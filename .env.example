# Copy to .env (git-ignored). Never commit real values.
# Paper endpoint is the default; live trading requires explicit owner opt-in.
LAB_BROKER_BASE_URL=https://paper-api.alpaca.markets
LAB_BROKER_API_KEY=
LAB_BROKER_API_SECRET=
# Registry/run-log DB. SQLite path for local dev; Postgres URL in production.
LAB_REGISTRY_URL=sqlite:///./data/registry.sqlite
# Starting capital for paper trading (USD). Changed from the website later.
LAB_CAPITAL_USD=10000
